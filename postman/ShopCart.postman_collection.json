    {
      "name": "Pago",
      "item": [
        {
          "name": "Listar envíos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pago/envios"
          }
        },
        {
          "name": "Crear dirección",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.IDDireccion) pm.environment.set('idDireccion', cuerpo.IDDireccion);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinatario\": \"Ana López\",\n  \"linea\": \"4a avenida 10-20\",\n  \"ciudad\": \"Guatemala\",\n  \"referencia\": null\n}"
            },
            "url": "{{baseUrl}}/pago/direcciones"
          }
        },
        {
          "name": "Listar direcciones",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/pago/direcciones"
          }
        },
        {
          "name": "Iniciar pago",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const llave = `pago-${Date.now()}-${crypto.randomUUID()}`.slice(0, 64);",
                  "pm.environment.set('llavePago', llave);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "if (cuerpo.pedido && cuerpo.pedido.IDPedido) pm.environment.set('idPedido', cuerpo.pedido.IDPedido);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idDireccion\": {{idDireccion}},\n  \"idMetodoEnvio\": 1,\n  \"llave\": \"{{llavePago}}\"\n}"
            },
            "url": "{{baseUrl}}/pago/iniciar"
          }
        },
        {
          "name": "Cobrar pago",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const llave = pm.environment.get('llavePago');",
                  "if (!llave || String(llave).includes('{{')) {",
                  "  throw new Error('Ejecuta primero Iniciar pago. Esa request genera llavePago para el cobro.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"llave\": \"{{llavePago}}\",\n  \"aprobado\": true\n}"
            },
            "url": "{{baseUrl}}/pago/cobrar"
          }
        },
        {
          "name": "Consultar pedido",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/pago/pedidos/{{idPedido}}"
          }
        },
        {
          "name": "Desactivar dirección",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/pago/direcciones/{{idDireccion}}/desactivar"
          }
        }
      ]
    },
