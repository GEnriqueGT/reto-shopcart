    {
      "name": "Carrito",
      "item": [
        {
          "name": "Consultar carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.headers.get('Carrito-Token');",
                  "if (token) pm.environment.set('tokenCarrito', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Carrito-Token", "value": "{{tokenCarrito}}" }
            ],
            "url": "{{baseUrl}}/carrito"
          }
        },
        {
          "name": "Agregar ítem",
          "event": [
            {
              "listen": "test",
