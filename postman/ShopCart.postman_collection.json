        {
          "name": "Editar variante",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"MESA-ROBLE\",\n  \"precio\": \"24.50\",\n  \"existencia\": 4\n}"
            },
            "url": "{{baseUrl}}/catalogo/variantes/{{idVariante}}"
          }
