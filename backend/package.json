    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mssql": "9.1.8",
    "@types/node": "24.9.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.38.0",
    "prettier": "3.6.2",
